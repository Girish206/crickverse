# dev branch: the test app at https://dev-app.runmitra.in, on the API at
# https://dev-api.runmitra.in. Read by `npm run dev` and `npm run build:dev`
# (an Android app for testing). Not secret: these values end up inside the
# built app.
#
# The website ignores VITE_API_URL: it calls /api on its own address, which
# vercel.json (or, locally, the proxy below) forwards to the right API. The
# Android app calls this directly.
VITE_API_URL=https://dev-api.runmitra.in/api
# Where shared and scanned links (matches, team joins, player QR codes) open.
VITE_SITE_URL=https://dev-app.runmitra.in
# Where `npm run dev` forwards /api: the API running on this computer
# (../runmitra-api, npm run dev there), or https://dev-api.runmitra.in to use
# the deployed dev API without running it.
API_PROXY_TARGET=http://localhost:4000
