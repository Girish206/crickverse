{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ]",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "dev-app\\.runmitra\\.in" }],
      "destination": "https://dev-api.runmitra.in/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.runmitra.in/api/:path*"
    },
    {
      "source": "/tournaments/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Applebot|Googlebot|bingbot).*"
        },
        { "type": "host", "value": "(?<host>dev-app\\.runmitra\\.in)" }
      ],
      "destination": "https://dev-api.runmitra.in/api/cricket-preview?host=:host&path=tournaments/:rest*"
    },
    {
      "source": "/matches/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Applebot|Googlebot|bingbot).*"
        },
        { "type": "host", "value": "(?<host>dev-app\\.runmitra\\.in)" }
      ],
      "destination": "https://dev-api.runmitra.in/api/cricket-preview?host=:host&path=matches/:rest*"
    },
    {
      "source": "/tournaments/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Applebot|Googlebot|bingbot).*"
        },
        { "type": "host", "value": "(?<host>.*)" }
      ],
      "destination": "https://api.runmitra.in/api/cricket-preview?host=:host&path=tournaments/:rest*"
    },
    {
      "source": "/matches/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Applebot|Googlebot|bingbot).*"
        },
        { "type": "host", "value": "(?<host>.*)" }
      ],
      "destination": "https://api.runmitra.in/api/cricket-preview?host=:host&path=matches/:rest*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
